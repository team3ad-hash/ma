+    def test_set_ad_schedule_replaces_existing(self):
+        self.schedule_rows = [_schedule_row(111, "MONDAY", 0, 24)]
+        svc = self.mock_client.get_service("CampaignCriterionService")
+        windows = [
+            {"day_of_week": "SUNDAY", "start_hour": 8, "end_hour": 20},
