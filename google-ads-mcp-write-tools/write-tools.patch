+def _resp(*resource_names: str) -> MagicMock:
+    resp = MagicMock()
+    items = []
+    for rn in resource_names:
+        item = MagicMock()
+        item.resource_name = rn
+        items.append(item)
+    resp.results = items
+    return resp
+
